{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/Unauthorized/layout,_N_T_/Unauthorized/page,_N_T_/Unauthorized"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/Unauthorized/__PAGE__",
    "/Unauthorized",
    "/_index",
    "/_head"
  ]
}